# HLS Agent 环境变量示例
#
# 用法：
#   Linux/macOS:  cp serve/env.example serve/env.sh && source serve/env.sh
#   Windows:      在「系统属性 > 环境变量」里逐条添加，或用 set 临时设置
#
# 不设置任何变量时，程序按「本地 Ollama > 本地 OpenAI 兼容服务 > 远程兼容端点」
# 的顺序自动探测，所以只有需要固定某个后端时才要动这里。

# ---------------------------------------------------------------------------
# 后端选择
# ---------------------------------------------------------------------------
# auto（默认，自动探测）/ ollama / openai / anthropic
HLS_AGENT_BACKEND=ollama

# 模型名，必须与服务端已拉取的模型一致
HLS_AGENT_MODEL=qwen2.5-coder:7b

# ---------------------------------------------------------------------------
# 本地推理服务地址
# ---------------------------------------------------------------------------
# Ollama 默认端口
HLS_AGENT_OLLAMA_HOST=http://127.0.0.1:11434

# vLLM / LM Studio / llama.cpp server 等 OpenAI 兼容服务
HLS_AGENT_OPENAI_BASE_URL=http://127.0.0.1:8000

# ---------------------------------------------------------------------------
# 远程 Anthropic 兼容端点（开发期用，正式评测环境请改用本地模型）
# ---------------------------------------------------------------------------
# HLS_AGENT_BASE_URL=https://api.deepseek.com/anthropic
# HLS_AGENT_API_KEY=sk-xxxxxxxx

# ---------------------------------------------------------------------------
# 生成参数
# ---------------------------------------------------------------------------
# 单次输出上限。推理模型会先输出思考内容，太小会导致正文被截断
HLS_AGENT_MAX_TOKENS=16384

# 思考控制（生成时间的主要来源，实测关闭后输出 token 减半以上）：
#   off      完全不输出思考（默认，最快）
#   budget:N 给思考 N token 预算（难题质量下降时可用，如 budget:2048）
HLS_AGENT_THINKING=off

# 单次调用超时（秒）。CPU 推理较慢，本地跑小模型时建议调大
HLS_AGENT_LLM_TIMEOUT=300

# ---------------------------------------------------------------------------
# 运行环境
# ---------------------------------------------------------------------------
# Vitis 工作区，必须是纯 ASCII 路径（Vitis 打不开含中文的路径）
# HLS_AGENT_WORKSPACE=D:\hls_work

# Vitis 命令行入口，一般自动查找即可
# HLS_AGENT_VITIS_RUN=/tools/Xilinx/Vitis/2025.2/bin/vitis-run
